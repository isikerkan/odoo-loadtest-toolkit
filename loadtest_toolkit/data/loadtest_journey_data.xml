<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="journey_browser" model="loadtest.journey">
        <field name="name">Browser</field>
        <field name="code">Browser</field>
        <field name="sequence">10</field>
        <field name="description">Read-only user: partner/product/order lists, form reads, product search.</field>
    </record>
    <record id="journey_sales_rep" model="loadtest.journey">
        <field name="name">Sales Rep</field>
        <field name="code">SalesRep</field>
        <field name="sequence">20</field>
        <field name="description">Creates and confirms sale orders and discusses them in the chatter.</field>
    </record>
    <record id="journey_chatter" model="loadtest.journey">
        <field name="name">Chatter</field>
        <field name="code">Chatter</field>
        <field name="sequence">30</field>
        <field name="description">Posts notes on accounts and reads chatter threads.</field>
    </record>
    <record id="journey_catalog_editor" model="loadtest.journey">
        <field name="name">Catalog Editor</field>
        <field name="code">CatalogEditor</field>
        <field name="sequence">40</field>
        <field name="description">Creates partners and products (needs Sales Manager rights).</field>
    </record>
    <record id="journey_presence" model="loadtest.journey">
        <field name="name">Presence (websocket)</field>
        <field name="code">Presence</field>
        <field name="sequence">50</field>
        <field name="description">Open browser tab: holds a bus websocket, subscribes, sends presence heartbeats, drains notifications. Pins one server thread per user in threaded mode.</field>
    </record>
    <record id="journey_error_lab" model="loadtest.journey">
        <field name="name">Error Lab</field>
        <field name="code">ErrorLab</field>
        <field name="sequence">60</field>
        <field name="description">Calls the sentry_error_lab endpoints (deliberate RPC errors, bad SQL, slow requests, HTTP 500) so Sentry gets a known error volume during the run. Needs the sentry_error_lab module installed and armed on the target.</field>
    </record>
</odoo>
