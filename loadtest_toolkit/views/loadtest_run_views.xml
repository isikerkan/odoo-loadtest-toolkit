<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="loadtest_run_view_form" model="ir.ui.view">
        <field name="name">loadtest.run.form</field>
        <field name="model">loadtest.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state == 'running'" />
                    <button name="action_stop" type="object" string="Stop" class="btn-danger" invisible="state != 'running'" confirm="Stop this run now? Results collected so far are kept." />
                    <button name="action_restart" type="object" string="Restart" invisible="state != 'running'" confirm="Stop and start this run again? Current results are discarded." />
                    <button name="action_repeat" type="object" string="Repeat" invisible="state not in ('done', 'failed')" />
                    <button name="action_refresh" type="object" string="Refresh" invisible="state != 'running'" />
                    <button name="action_open_sentry" type="object" string="Open in Sentry" invisible="not sentry_url" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_samples" type="object" class="oe_stat_button" icon="fa-line-chart" invisible="not sample_count">
                            <field name="sample_count" widget="statinfo" string="Samples" />
                        </button>
                    </div>
                    <group>
                        <group string="Run">
                            <field name="name" />
                            <field name="scenario_id" readonly="state != 'draft'" />
                            <field name="batch_id" />
                            <field name="started_at" />
                            <field name="stop_at" readonly="state in ('done', 'failed')" />
                            <field name="ended_at" />
                            <field name="port" invisible="not port" />
                        </group>
                        <group string="Live" invisible="state != 'running'">
                            <field name="live_state" />
                            <field name="live_users" />
                            <field name="live_rps" />
                            <field name="live_requests" />
                            <field name="live_failures" />
                            <field name="live_fail_ratio" widget="percentage" />
                        </group>
                        <group string="System (live)" invisible="state != 'running'">
                            <field name="sys_cpu" />
                            <field name="cpu_cores" />
                            <field name="sys_mem" />
                            <field name="sys_mem_used_gb" />
                            <field name="sys_rss_mb" />
                            <field name="sys_pg_active" />
                            <field name="sys_pg_total" />
                        </group>
                        <group string="Summary" invisible="state not in ('done', 'failed')">
                            <field name="total_requests" />
                            <field name="total_failures" />
                            <field name="failure_ratio" widget="percentage" />
                            <field name="rps_avg" />
                            <field name="p50" />
                            <field name="p95" />
                            <field name="p99" />
                        </group>
                        <group string="System Summary" invisible="state not in ('done', 'failed')">
                            <field name="avg_cpu" />
                            <field name="max_cpu" />
                            <field name="avg_mem" />
                            <field name="max_mem" />
                            <field name="avg_mem_used_gb" />
                            <field name="max_mem_used_gb" />
                            <field name="cpu_cores" />
                            <field name="avg_rss_mb" />
                            <field name="max_rss_mb" />
                            <field name="avg_pg_active" />
                            <field name="max_pg_active" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Results per Endpoint">
                            <field name="result_ids">
                                <list>
                                    <field name="method" />
                                    <field name="name" />
                                    <field name="requests" sum="Total" />
                                    <field name="failures" sum="Total" />
                                    <field name="median" />
                                    <field name="avg" />
                                    <field name="p95" />
                                    <field name="p99" />
                                    <field name="rps" />
                                </list>
                            </field>
                        </page>
                        <page string="Samples">
                            <field name="sample_ids">
                                <list>
                                    <field name="sampled_at" />
                                    <field name="users" />
                                    <field name="current_rps" />
                                    <field name="rps" />
                                    <field name="p50" />
                                    <field name="p95" />
                                    <field name="fail_ratio" widget="percentage" />
                                    <field name="requests" />
                                    <field name="failures" />
                                    <field name="cpu" />
                                    <field name="mem" />
                                    <field name="mem_used_gb" />
                                    <field name="rss_mb" />
                                    <field name="pg_active" />
                                    <field name="pg_total" />
                                </list>
                            </field>
                        </page>
                        <page string="Processes">
                            <field name="process_ids">
                                <list>
                                    <field name="role" />
                                    <field name="pid" />
                                    <field name="alive" />
                                </list>
                            </field>
                        </page>
                        <page string="Log">
                            <field name="log_excerpt" nolabel="1" />
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
                <!-- full-width timeline charts under the sheet, fed by the
                     poll samples; hidden until the first sample exists -->
                <div class="o_loadtest_run_charts" invisible="not sample_count">
                    <field name="chart_data" widget="loadtest_run_charts" nolabel="1" />
                </div>
            </form>
        </field>
    </record>
    <record id="loadtest_run_view_list" model="ir.ui.view">
        <field name="name">loadtest.run.list</field>
        <field name="model">loadtest.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="scenario_id" />
                <field name="started_at" />
                <field name="ended_at" />
                <field name="total_requests" />
                <field name="failure_ratio" widget="percentage" />
                <field name="rps_avg" />
                <field name="p95" />
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'running'" decoration-danger="state == 'failed'" />
            </list>
        </field>
    </record>
    <record id="loadtest_run_action" model="ir.actions.act_window">
        <field name="name">Runs</field>
        <field name="res_model">loadtest.run</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="loadtest_run_sample_view_graph" model="ir.ui.view">
        <field name="name">loadtest.run.sample.graph</field>
        <field name="model">loadtest.run.sample</field>
        <field name="arch" type="xml">
            <graph string="Run Samples" type="line" sample="1" disable_linking="1">
                <field name="sampled_at" interval="minute" type="row" />
                <field name="current_rps" type="measure" />
            </graph>
        </field>
    </record>
    <record id="loadtest_run_sample_view_list" model="ir.ui.view">
        <field name="name">loadtest.run.sample.list</field>
        <field name="model">loadtest.run.sample</field>
        <field name="arch" type="xml">
            <list string="Run Samples" create="0" edit="0">
                <field name="run_id" />
                <field name="sampled_at" />
                <field name="users" />
                <field name="current_rps" />
                <field name="rps" />
                <field name="p50" />
                <field name="p95" />
                <field name="fail_ratio" widget="percentage" />
                <field name="requests" />
                <field name="failures" />
                <field name="cpu" />
                <field name="mem" />
                <field name="mem_used_gb" />
                <field name="rss_mb" />
                <field name="pg_active" />
                <field name="pg_total" />
            </list>
        </field>
    </record>
    <record id="loadtest_run_sample_view_search" model="ir.ui.view">
        <field name="name">loadtest.run.sample.search</field>
        <field name="model">loadtest.run.sample</field>
        <field name="arch" type="xml">
            <search string="Run Samples">
                <field name="run_id" />
                <group expand="0" string="Group By">
                    <filter name="group_run" string="Run" context="{'group_by': 'run_id'}" />
                </group>
            </search>
        </field>
    </record>
</odoo>
