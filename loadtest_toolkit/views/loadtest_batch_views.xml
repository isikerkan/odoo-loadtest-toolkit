<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="loadtest_batch_view_form" model="ir.ui.view">
        <field name="name">loadtest.batch.form</field>
        <field name="model">loadtest.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_generate"
                        type="object"
                        string="Generate All"
                        class="btn-primary"
                        invisible="state == 'generated'"
                        confirm="Generate everything still missing for this batch?"
                    />
                    <button
                        name="action_cleanup"
                        type="object"
                        string="Clean Up All"
                        class="btn-danger"
                        invisible="state == 'draft'"
                        confirm="Delete everything this batch generated (and what its users created) and archive the users?"
                    />
                    <button name="action_generate_users" type="object" string="Generate Users" invisible="generated_user_count" />
                    <button name="action_generate_partners" type="object" string="Generate Partners" invisible="generated_partner_count" />
                    <button name="action_generate_products" type="object" string="Generate Products" invisible="generated_product_count" />
                    <button name="action_generate_orders" type="object" string="Generate Orders" invisible="generated_order_count or not (generated_user_count and generated_partner_count and generated_product_count)" />
                    <button name="action_cleanup_orders" type="object" string="Clean Up Orders" invisible="not generated_order_count" confirm="Delete the generated orders and those the test users created?" />
                    <button name="action_cleanup_products" type="object" string="Clean Up Products" invisible="not generated_product_count or generated_order_count" confirm="Delete the generated products and those the test users created?" />
                    <button name="action_cleanup_partners" type="object" string="Clean Up Partners" invisible="not generated_partner_count or generated_order_count" confirm="Delete the generated partners and those the test users created?" />
                    <button name="action_cleanup_users" type="object" string="Clean Up Users" invisible="not generated_user_count or generated_order_count" confirm="Archive the users and delete the chatter messages they wrote?" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="state == 'draft'">
                        <button name="action_view_users" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="generated_user_count" widget="statinfo" string="Users" />
                        </button>
                        <button name="action_view_partners" type="object" class="oe_stat_button" icon="fa-address-book">
                            <field name="generated_partner_count" widget="statinfo" string="Partners" />
                        </button>
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="generated_product_count" widget="statinfo" string="Products" />
                        </button>
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="generated_order_count" widget="statinfo" string="Orders" />
                        </button>
                    </div>
                    <group>
                        <field name="name" />
                        <field name="password" readonly="generated_user_count" />
                    </group>
                    <group string="Volumes">
                        <field name="user_count" readonly="generated_user_count" />
                        <field name="partner_count" readonly="generated_partner_count" />
                        <field name="product_count" readonly="generated_product_count" />
                        <field name="order_count" readonly="generated_order_count" />
                    </group>
                    <notebook>
                        <page string="Test Users"><field name="user_ids" readonly="1" /></page>
                        <page string="Partners"><field name="partner_ids" readonly="1" /></page>
                        <page string="Products"><field name="product_ids" readonly="1" /></page>
                        <page string="Orders"><field name="order_ids" readonly="1" /></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="loadtest_batch_view_list" model="ir.ui.view">
        <field name="name">loadtest.batch.list</field>
        <field name="model">loadtest.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="generated_user_count" string="Users" />
                <field name="generated_partner_count" string="Partners" />
                <field name="generated_product_count" string="Products" />
                <field name="generated_order_count" string="Orders" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="loadtest_batch_action" model="ir.actions.act_window">
        <field name="name">Load Test Batches</field>
        <field name="res_model">loadtest.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="loadtest_root_menu"
        name="Load Testing"
        action="loadtest_batch_action"
        groups="base.group_system"
        sequence="900"
        web_icon="loadtest_toolkit,static/description/icon.png"
    />
</odoo>
