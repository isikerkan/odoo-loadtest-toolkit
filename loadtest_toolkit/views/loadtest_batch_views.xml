<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="loadtest_batch_view_form" model="ir.ui.view">
        <field name="name">loadtest.batch.form</field>
        <field name="model">loadtest.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_generate"
                        type="object"
                        string="Generate Data"
                        class="btn-primary"
                        invisible="state != 'draft'"
                        confirm="Generate the configured users and data on this database?"
                    />
                    <button
                        name="action_cleanup"
                        type="object"
                        string="Clean Up"
                        class="btn-danger"
                        invisible="state != 'generated'"
                        confirm="Delete all records generated by this batch and archive its users?"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="state == 'draft'">
                        <button name="action_view_users" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="generated_user_count" widget="statinfo" string="Users" />
                        </button>
                        <button name="action_view_partners" type="object" class="oe_stat_button" icon="fa-address-book">
                            <field name="generated_partner_count" widget="statinfo" string="Partners" />
                        </button>
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="generated_product_count" widget="statinfo" string="Products" />
                        </button>
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="generated_order_count" widget="statinfo" string="Orders" />
                        </button>
                    </div>
                    <group>
                        <group string="Batch">
                            <field name="name" />
                            <field name="generated_summary" invisible="not generated_summary" />
                        </group>
                        <group string="Volumes">
                            <field name="user_count" readonly="state != 'draft'" />
                            <field name="partner_count" readonly="state != 'draft'" />
                            <field name="product_count" readonly="state != 'draft'" />
                            <field name="order_count" readonly="state != 'draft'" />
                            <field name="password" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Test Users">
                            <field name="user_ids" readonly="1" />
                        </page>
                        <page string="Partners">
                            <field name="partner_ids" readonly="1" />
                        </page>
                        <page string="Products">
                            <field name="product_ids" readonly="1" />
                        </page>
                        <page string="Orders">
                            <field name="order_ids" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="loadtest_batch_view_list" model="ir.ui.view">
        <field name="name">loadtest.batch.list</field>
        <field name="model">loadtest.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="user_count" />
                <field name="partner_count" />
                <field name="product_count" />
                <field name="order_count" />
                <field name="generated_summary" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="loadtest_batch_action" model="ir.actions.act_window">
        <field name="name">Load Test Batches</field>
        <field name="res_model">loadtest.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="loadtest_root_menu"
        name="Load Testing"
        action="loadtest_batch_action"
        groups="base.group_system"
        sequence="900"
    />
</odoo>
